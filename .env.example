# KONTACT — Catalog Vision RAG System
# Copy to .env and fill in your keys

# Required
OPENROUTER_API_KEY=your-key-here

# Optional (defaults shown)
VISION_MODEL=google/gemini-3.1-flash-lite-preview
EMBEDDING_MODEL=openai/text-embedding-3-small
MAX_WORKERS=8
PORT=8000

# Sync channels (optional)
# If set, FastAPI startup will auto-launch the WeChat desktop watcher on this folder
WECHAT_WATCH_DIR=
# IMAP email poller (use /api/sync/email/start to actually launch)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
