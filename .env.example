# KONTACT — Catalog Vision RAG System
# Copy to .env and fill in real values. Never commit .env.

# ─── REQUIRED ─────────────────────────────────────────────────────────

# LLM + embeddings (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Session token signer. Must be >=32 chars. Server refuses to start otherwise.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-output-of-secrets-token_urlsafe-48

# Super admin bootstrap (email + password login only)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe-strong-password
SUPER_ADMIN_NAME=Super Admin

# ─── SECURITY (production HTTPS) ──────────────────────────────────────

# Comma-separated origins. Use "*" only for local dev (disables credentials).
CORS_ORIGINS=http://localhost:8090,http://localhost:5173

# Set to "true" when serving over HTTPS in production.
COOKIE_SECURE=false

# Session cookie lifetime (days)
SESSION_DAYS=14

# ─── HTTPS via Caddy (optional, opt-in profile) ───────────────────────

# Set when running `docker compose --profile https up -d`
DOMAIN=kontact.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ─── UPLOAD CAPS ──────────────────────────────────────────────────────

MAX_UPLOAD_BYTES=104857600         # 100 MB per file
MAX_IMAGE_PIXELS=100000000         # PIL decompression bomb guard (100 MP)

# ─── RATE LIMIT ───────────────────────────────────────────────────────

RATE_LIMIT_ENABLED=true

# ─── MODELS / RUNTIME ─────────────────────────────────────────────────

VISION_MODEL=google/gemini-3.1-flash-lite-preview
EMBEDDING_MODEL=openai/text-embedding-3-small
MAX_WORKERS=8
PORT=8090

# ─── SYNC CHANNELS (optional) ─────────────────────────────────────────

# If set, FastAPI startup will auto-launch the WeChat desktop watcher.
WECHAT_WATCH_DIR=

# IMAP email poller (use /api/sync/email/start to launch).
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
